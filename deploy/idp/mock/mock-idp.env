# Issuer the mock IdP puts into tokens and advertises in its discovery document.
# The SAME URL is reachable from browsers (kind port mapping) and from pods
# (CoreDNS rewrite) - that is the whole point of the nip.io hostname.
MOCK_ISSUER=http://idp.127.0.0.1.nip.io
# generic | keycloak | entra | oracle - shape of the claims in the access token.
# Change it together with ROLES_CLAIM in the overlay to rehearse a real IdP.
MOCK_FLAVOR=generic
MOCK_AUDIENCE=k8sgateway-api
MOCK_USERS_FILE=/config/users.json
# PKCS#8 RSA key mounted from Secret mock-idp-key (see deployment.yaml). If the
# file is missing the mock IdP generates a fresh key at every start, which
# invalidates all tokens issued before the restart.
MOCK_KEY_FILE=/keys/key.pem
MOCK_ACCESS_TOKEN_TTL=300
MOCK_ID_TOKEN_TTL=300
MOCK_REFRESH_TOKEN_TTL=1800
# Dev convenience: accept any redirect_uri. Set to false to enforce the
# registered redirect URIs like a real IdP does.
MOCK_ALLOW_ANY_REDIRECT=true
LOG_LEVEL=info
