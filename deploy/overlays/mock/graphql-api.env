# GraphQL API (Node) - mock IdP (development, runs in the cluster)
OIDC_ISSUER=http://idp.127.0.0.1.nip.io
OIDC_AUDIENCE=k8sgateway-api
ROLES_CLAIM=roles
ROLE_USER=user
ROLE_ADMIN=admin
CORS_ORIGINS=http://angular.127.0.0.1.nip.io,http://next.127.0.0.1.nip.io
# restOrders query relays the caller's bearer token to the REST API in-cluster.
REST_API_INTERNAL_URL=http://rest-api.k8sgateway.svc.cluster.local:8080
LOG_LEVEL=info
