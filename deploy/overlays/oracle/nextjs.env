# Next.js BFF - Oracle IAM Identity Domains (cloud; replace the placeholders, see README.md)
OIDC_ISSUER=https://<DOMAIN_URL>
# Oracle publishes a discovery document whose 'issuer' is NOT the URL it was fetched
# from, so the expected iss claim and the JWKS location are given explicitly.
OIDC_ISSUER_CLAIM=https://identity.oraclecloud.com/
OIDC_JWKS_URI=https://<DOMAIN_URL>/admin/v1/SigningCert/jwk
OIDC_CLIENT_ID=<NEXTJS_CLIENT_ID>
# client_secret_post (default) | client_secret_basic (Oracle) | none (public client)
OIDC_CLIENT_AUTH=client_secret_basic
OIDC_SCOPE=openid profile email offline_access https://api.k8sgateway.local/orders.read
OIDC_AUDIENCE=https://api.k8sgateway.local/
# false allows the plain-http dev IdPs; must be true for real IdPs.
OIDC_REQUIRE_HTTPS=true
# VERIFY against a decoded access token from your domain: Oracle only puts
# groups/app roles into the access token via a custom claim (see README.md).
ROLES_CLAIM=groups
ROLE_USER=user
ROLE_ADMIN=admin
# Own external URL: every redirect_uri is derived from it (never from the request).
PUBLIC_URL=http://next.127.0.0.1.nip.io
API_URL=http://api.127.0.0.1.nip.io
GRAPHQL_URL=http://graphql.127.0.0.1.nip.io/graphql
# Server-side relays go straight to the Services, not through the gateway.
REST_API_INTERNAL_URL=http://rest-api.k8sgateway.svc.cluster.local:8080
GRAPHQL_INTERNAL_URL=http://graphql-api.k8sgateway.svc.cluster.local:4000/graphql
OIDC_IDP_NAME=Oracle IAM Identity Domains
LOG_LEVEL=info
