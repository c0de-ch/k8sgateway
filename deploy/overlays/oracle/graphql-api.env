# GraphQL API (Node) - Oracle IAM Identity Domains (cloud; replace the placeholders, see README.md)
OIDC_ISSUER=https://<DOMAIN_URL>
# Oracle publishes a discovery document whose 'issuer' is NOT the URL it was fetched
# from, so the expected iss claim and the JWKS location are given explicitly.
OIDC_ISSUER_CLAIM=https://identity.oraclecloud.com/
OIDC_JWKS_URI=https://<DOMAIN_URL>/admin/v1/SigningCert/jwk
OIDC_AUDIENCE=https://api.k8sgateway.local/
# VERIFY against a decoded access token from your domain: Oracle only puts
# groups/app roles into the access token via a custom claim (see README.md).
ROLES_CLAIM=groups
ROLE_USER=user
ROLE_ADMIN=admin
CORS_ORIGINS=http://angular.127.0.0.1.nip.io,http://next.127.0.0.1.nip.io
# restOrders query relays the caller's bearer token to the REST API in-cluster.
REST_API_INTERNAL_URL=http://rest-api.k8sgateway.svc.cluster.local:8080
LOG_LEVEL=info
