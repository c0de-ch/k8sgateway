# Next.js BFF - Microsoft Entra ID (cloud; replace the placeholders, see README.md)
OIDC_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
OIDC_CLIENT_ID=<NEXTJS_CLIENT_ID>
# client_secret_post (default) | client_secret_basic (Oracle) | none (public client)
OIDC_CLIENT_AUTH=client_secret_post
OIDC_SCOPE=openid profile email offline_access api://<API_CLIENT_ID>/access_as_user
OIDC_AUDIENCE=<API_CLIENT_ID>
# false allows the plain-http dev IdPs; must be true for real IdPs.
OIDC_REQUIRE_HTTPS=true
ROLES_CLAIM=roles
ROLE_USER=user
ROLE_ADMIN=admin
# Own external URL: every redirect_uri is derived from it (never from the request).
PUBLIC_URL=http://next.127.0.0.1.nip.io
API_URL=http://api.127.0.0.1.nip.io
GRAPHQL_URL=http://graphql.127.0.0.1.nip.io/graphql
# Server-side relays go straight to the Services, not through the gateway.
REST_API_INTERNAL_URL=http://rest-api.k8sgateway.svc.cluster.local:8080
GRAPHQL_INTERNAL_URL=http://graphql-api.k8sgateway.svc.cluster.local:4000/graphql
OIDC_IDP_NAME=Microsoft Entra ID
LOG_LEVEL=info
