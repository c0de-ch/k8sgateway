# REST API (Go) - Microsoft Entra ID (cloud; replace the placeholders, see README.md)
# Discovery: ${OIDC_ISSUER}/.well-known/openid-configuration
OIDC_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# Access tokens must carry this value in "aud", otherwise 401.
OIDC_AUDIENCE=<API_CLIENT_ID>
# Dotted path to the roles array inside the ACCESS token.
ROLES_CLAIM=roles
ROLE_USER=user
ROLE_ADMIN=admin
CORS_ORIGINS=http://angular.127.0.0.1.nip.io,http://next.127.0.0.1.nip.io
LOG_LEVEL=info
