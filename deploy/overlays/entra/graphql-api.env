# GraphQL API (Node) - Microsoft Entra ID (cloud; replace the placeholders, see README.md)
OIDC_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
OIDC_AUDIENCE=<API_CLIENT_ID>
ROLES_CLAIM=roles
ROLE_USER=user
ROLE_ADMIN=admin
CORS_ORIGINS=http://angular.127.0.0.1.nip.io,http://next.127.0.0.1.nip.io
# restOrders query relays the caller's bearer token to the REST API in-cluster.
REST_API_INTERNAL_URL=http://rest-api.k8sgateway.svc.cluster.local:8080
LOG_LEVEL=info
