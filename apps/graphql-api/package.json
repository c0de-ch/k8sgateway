{
  "name": "graphql-api",
  "version": "1.0.0",
  "private": true,
  "description": "JWT-protected GraphQL API (Apollo Server 5 + Express 5 + jose) for the k8sgateway tutorial",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "cors": "2.8.6",
    "express": "5.2.1",
    "graphql": "16.14.2",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
